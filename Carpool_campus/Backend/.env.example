# Server
PORT=5000
NODE_ENV=development
API_BASE_PATH=/api/v1

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/carpoolcampus

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Approved campus email domains (comma separated)
APPROVED_EMAIL_DOMAINS=campus.edu,gcu.edu.pk

# OTP
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60

# Nodemailer (Google SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="CarpoolCampus <no-reply@carpoolcampus.app>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Matching engine (TBD tunables per API.md §16)
MATCH_MIN_OVERLAP_DEFAULT=0.3
MATCH_MAX_GEO_DISTANCE_KM=3
MATCH_MAX_TIME_DIFF_MIN=60

# Cost-Split fuel constants (TBD per API.md §11)
FUEL_PRICE_DEFAULT_PER_LITER=285.5
FUEL_EFFICIENCY_KM_PER_LITER=5


SHARE_STATUS_TTL_SECONDS=14400
SHARE_STATUS_BASE_URL=https://carpoolcampus.app/track